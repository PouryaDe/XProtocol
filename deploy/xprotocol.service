[Unit]
Description=XProtocol Open-Core VPN Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/xprotocol/server
Environment=XPROTOCOL_DATA_DIR=/var/lib/xprotocol
Environment=XPROTOCOL_PORT=2053
ExecStart=/usr/bin/node /opt/xprotocol/server/dist/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
